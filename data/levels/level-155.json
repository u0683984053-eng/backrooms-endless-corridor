  "setPieces": [
    {
      "type": "object",
      "position": "random",
      "text": "路边停着一辆没熄火的车，引擎盖还是温的，车门虚掩。车里放着一杯咖啡，还是热的。后视镜上挂着一张全家福——照片里没有你，但车里只有一个座位，椅子上有你的指纹。",
      "sanityEffect": -6,
      "note": "路边温热的车里，只有一个座位，椅上有我的指纹。"
    },
    {
      "type": "writing",
      "position": "random",
      "text": "路面用荧光漆画着一行巨大的字：『前方 500 米：出口。』你走了十公里，它还在前方 500 米。",
      "sanityEffect": -4,
      "note": "路面上的出口标志永远在前方 500 米。"
    },
    {
      "type": "object",
      "position": "random",
      "text": "路灯下立着一只行李箱，拉链半开。你路过时，它自己合上了。你回头看——它又慢慢拉开，像在等你往里放点什么。",
      "sanityEffect": -4,
      "note": "路灯下的行李箱自己开合。"
    }
  ],
