  "setPieces": [
    {
      "type": "mural",
      "position": "random",
      "text": "石壁上密密麻麻印着掌印，从婴儿手掌大小到成年人的手掌，层层叠叠，沿着岩壁一直延伸到黑暗深处看不清的地方。",
      "sanityEffect": -6,
      "note": "石壁上的手印，大小不一，层层叠叠伸向黑暗。"
    },
    {
      "type": "object",
      "position": "far-corner",
      "text": "一小片苔藓在黑暗中发出柔和的蓝绿色光。这是这里唯一的光源，安静、温驯。你在它旁边坐了很久，第一次觉得洞穴也不算太糟。",
      "sanityEffect": 2,
      "note": "发光的苔藓。黑暗里难得的亮光。"
    },
    {
      "type": "object",
      "position": "far-corner",
      "text": "洞穴深处传来一声呼唤，用的是你的名字。你循声走了很远，最终发现那只是你自己脚步声的回声，被石壁拉长、扭曲成了人声。",
      "sanityEffect": -5,
      "note": "深处有人叫你的名字。追过去才发现是回声。"
    }
  ],
  "soundscape": {
    "ambient": [
