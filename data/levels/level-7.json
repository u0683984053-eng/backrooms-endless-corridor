  "setPieces": [
    {
      "type": "object",
      "position": "random",
      "text": "水下一臂深的地方有一排金属扶手，锈迹斑斑，沿着走廊一直延伸向黑暗。它本该出现在台阶旁——但这里没有台阶。",
      "sanityEffect": -4,
      "note": "水面下的扶手，沿着走廊伸向黑暗。没有台阶，它扶着谁？"
    },
    {
      "type": "object",
      "position": "random",
      "text": "几页纸漂浮在水面上，墨迹晕开大半。最后一行勉强可读：『水位在涨。别再回头看了。』",
      "sanityEffect": -3,
      "note": "漂浮的纸页：『水位在涨。别再回头看了。』"
    },
    {
      "type": "weird-room",
      "position": "far-corner",
      "text": "走廊尽头的天花板灯倒映在水里，但倒影里的灯比头顶多了一盏——多出的那一盏沉在更深的水底，朝你眨了一下。",
      "sanityEffect": -6,
      "note": "水底的倒影里多了一盏灯。它在看你。"
    },
    {
      "type": "weird-room",
      "position": "random",
      "text": "水面的倒影比你慢半拍。你停下，它也停下；你低头看它，它还在看你。",
      "sanityEffect": -5,
      "note": "水中的倒影比我慢半拍。"
    },
    {
      "type": "object",
      "position": "random",
      "text": "排水口被一把锁锁住了。锁很新，没有一丝锈迹。",
      "sanityEffect": -3,
      "note": "排水口锁着一把新锁。"
    }
  ],
