  "setPieces": [
    { "type": "object", "position": "random", "text": "门廊的秋千在无风的傍晚轻轻摇晃，好像有人刚刚起身离开。坐垫上还残留着体温的错觉。", "sanityEffect": -4, "note": "无风的傍晚，门廊秋千在摇晃。" },
    { "type": "weird-room", "position": "far-corner", "text": "推开一扇虚掩的门，餐厅里摆着三副餐具，食物还在冒热气，餐巾叠得整整齐齐。墙上挂着全家福——照片里的每一张脸都是模糊的。", "sanityEffect": -6, "note": "晚餐还在冒热气。全家福里没有一张清晰的脸。" },
    { "type": "object", "position": "random", "text": "客厅的电视机亮着，屏幕上是满屏的雪花，沙沙声在空房间里格外清晰。电源线没有插进插座。", "sanityEffect": -7, "note": "没插电的电视，亮着雪花。" }
  ],
